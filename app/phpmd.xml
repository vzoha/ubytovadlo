<?xml version="1.0"?>
<ruleset name="Ubytovadlo"
         xmlns="http://pmd.sf.net/ruleset/1.0.0"
         xsi:schemaLocation="http://pmd.sf.net/ruleset/1.0.0 http://pmd.sf.net/ruleset_xml_schema.xsd"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <description>
        Mechanicky měřitelné signály clean code / SOLID pro nový kód.
        Pouští se přes `composer review` jen na soubory změněné oproti main —
        je to branka pro nové funkce, ne audit celé historie.
    </description>

    <rule ref="rulesets/cleancode.xml">
        <!-- Symfony i Doctrine stojí na statických továrnách a konstantách. -->
        <exclude name="StaticAccess" />
        <!-- Časté a legitimní u ranných returnů ve validacích. -->
        <exclude name="MissingImport" />
    </rule>

    <rule ref="rulesets/codesize.xml">
        <!-- Entity a jejich mapování: hodně krátkých getterů/setterů a polí je v pořádku,
             hlídáme radši délku a složitost metod. -->
        <exclude name="TooManyPublicMethods" />
        <exclude name="ExcessiveClassLength" />
        <exclude name="TooManyFields" />
        <exclude name="TooManyMethods" />
        <exclude name="ExcessiveClassComplexity" />
    </rule>
    <rule ref="rulesets/codesize.xml/TooManyMethods">
        <properties>
            <property name="maxmethods" value="35" />
        </properties>
    </rule>
    <rule ref="rulesets/codesize.xml/ExcessiveClassComplexity">
        <properties>
            <property name="maximum" value="60" />
        </properties>
    </rule>

    <rule ref="rulesets/design.xml">
        <exclude name="CouplingBetweenObjects" />
    </rule>
    <!-- Vyšší práh: servisy legitimně skládají víc závislostí než průměrná třída. -->
    <rule ref="rulesets/design.xml/CouplingBetweenObjects">
        <properties>
            <property name="maximum" value="20" />
        </properties>
    </rule>

    <rule ref="rulesets/naming.xml">
        <exclude name="ShortVariable" />
        <exclude name="LongVariable" />
        <exclude name="ShortMethodName" />
    </rule>

    <rule ref="rulesets/unusedcode.xml">
        <!-- Symfony předává do listenerů a controllerů argumenty, které nepotřebujeme. -->
        <exclude name="UnusedFormalParameter" />
    </rule>
</ruleset>
