{# Přímé rezervace — kanál bez napojení: nic se odnikud netahá, jen zprávy hostům.
   Očekává: directMessaging. #}
<div class="card mb-3">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2 py-2">
        <span class="d-flex align-items-center gap-2">
            <button class="btn btn-sm btn-outline-secondary py-0 px-1" type="button" data-bs-toggle="collapse"
                    data-bs-target="#channel-direct" aria-expanded="false"
                    aria-controls="channel-direct" aria-label="Nastavení kanálu Přímá">▾</button>
            <span class="fw-semibold">Přímá</span>
        </span>
    </div>
    <div class="collapse" id="channel-direct">
        <div class="card-body">
            <p class="text-muted small mb-2">Rezervace domluvené telefonem, mailem nebo osobně — zadáváte je rovnou tady.</p>
            <form method="post" action="{{ path('channel_settings_messaging_save') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('connector') }}">
                <label class="form-label small text-muted mb-1" for="messaging-direct">Zprávy hostům</label>
                <div class="input-group input-group-sm">
                    <select class="form-select" name="messaging[direct]" id="messaging-direct">
                        {% for option in directMessaging.options %}
                            <option value="{{ option.value }}" {{ option == directMessaging.selected ? 'selected' : '' }}>{{ option.label }}</option>
                        {% endfor %}
                    </select>
                    <button type="submit" class="btn btn-outline-primary">Uložit</button>
                </div>
                <div class="form-text small">{{ directMessaging.selected.description }}</div>
            </form>
        </div>
    </div>
</div>
