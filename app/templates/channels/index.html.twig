{% extends 'settings/base.html.twig' %}

{% block title %}Nastavení — kanály a platby{% endblock %}

{% block settings_active %}channels{% endblock %}

{% block settings_content %}
    {% set channels = active|filter(c => not c.type.isPaymentSource) %}
    {% set payments = active|filter(c => c.type.isPaymentSource) %}
    <div class="d-flex justify-content-between align-items-center mb-2 gap-2 flex-wrap">
        <h2 class="h5 mb-0">Kanály a platby</h2>
        {% if available is not empty %}
            <div class="dropdown">
                <button class="btn btn-sm btn-primary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    + Přidat napojení
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    {% for group in [
                        {label: 'Prodejní kanály', items: available|filter(c => not c.type.isPaymentSource)},
                        {label: 'Platby', items: available|filter(c => c.type.isPaymentSource)}
                    ] %}
                        {% if group.items is not empty %}
                            <li><h6 class="dropdown-header">{{ group.label }}</h6></li>
                            {% for c in group.items %}
                                <li>
                                    <form method="post" action="{{ path('channel_settings_add', { type: c.type.value }) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('connector') }}">
                                        <button type="submit" class="dropdown-item">{{ c.type.label }}</button>
                                    </form>
                                </li>
                            {% endfor %}
                        {% endif %}
                    {% endfor %}
                </ul>
            </div>
        {% endif %}
    </div>
    <p class="text-muted small">
        Odkud chodí rezervace a platby. Každé napojení má vlastní stav, přístupy
        i feed obsazenosti; vypnuté pravidelné kontroly přeskočí.
    </p>

    {% if not cipherReady %}
        <div class="alert alert-warning">
            Není nastaven <code>APP_CREDENTIALS_KEY</code> — přístupy se do databáze neuloží.
            Vygenerujte klíč a vložte do <code>.env.local</code>:
            <code>php -r "echo base64_encode(random_bytes(32)).PHP_EOL;"</code>
        </div>
    {% endif %}

    {% if active is empty %}
        <div class="alert alert-light border text-muted">
            Zatím žádné napojení. Přidejte to, přes které prodáváte nebo přijímáte platby —
            tlačítkem nahoře.
        </div>
    {% endif %}

    {% if channels is not empty %}
        <h3 class="h6 text-muted mt-3">Prodejní kanály</h3>
        {% for c in channels %}
            {{ include('channels/_card.html.twig') }}
        {% endfor %}
    {% endif %}

    {% if payments is not empty %}
        <h3 class="h6 text-muted mt-3">Platby</h3>
        {% for c in payments %}
            {{ include('channels/_card.html.twig') }}
        {% endfor %}
    {% endif %}

    <div class="border rounded p-3 mt-4 bg-body-tertiary">
        <label class="form-label fw-semibold mb-1" for="ical-feed-url">Náš kalendář → do portálů</label>
        <p class="text-muted small mb-2">
            Jedna adresa pro všechny portály: obsahuje všechny rezervace jako obsazené termíny.
            Vložte ji v každém portálu do <em>importu kalendáře</em> — portál pak neprodá termín
            obsazený jiným kanálem, webem ani přímou rezervací. Ven jde jen „obsazeno",
            žádné údaje hosta.
        </p>
        <div class="input-group input-group-sm">
            <input type="text" class="form-control font-monospace" id="ical-feed-url" value="{{ icalFeedUrl }}" readonly>
            <button type="button" class="btn btn-outline-secondary" data-copy="#ical-feed-url">Kopírovat</button>
        </div>
    </div>

{% endblock %}

{% block javascripts %}
<script>
    document.querySelectorAll('[data-copy]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            const field = document.querySelector(btn.dataset.copy);
            navigator.clipboard.writeText(field.value).then(function () {
                const orig = btn.textContent;
                btn.textContent = 'Zkopírováno';
                setTimeout(function () { btn.textContent = orig; }, 1500);
            });
        });
    });
</script>
{% endblock %}
