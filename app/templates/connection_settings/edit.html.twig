{% extends 'settings/base.html.twig' %}

{% block title %}Nastavení — připojení{% endblock %}

{% block settings_active %}connection{% endblock %}

{% block settings_content %}
    <h2 class="h5 mb-2">Připojení k poště</h2>
    <p class="text-muted small">
        Schránka, ze které aplikace čte zprávy portálů a banky, a server, kterým
        odesílá. Údaje se ukládají <strong>šifrovaně</strong> v databázi a hesla
        se nikdy nezobrazují zpět — prázdné pole znamená beze změny.
        Přístupy k jednotlivým portálům patří do <a href="{{ path('sales_channel_index') }}">Prodejních kanálů</a>.
    </p>

    {% if not cipherReady %}
        <div class="alert alert-warning">
            Není nastaven <code>APP_CREDENTIALS_KEY</code> — uložení do databáze je vypnuté.
            Vygenerujte klíč a vložte do <code>.env.local</code>:
            <code>php -r "echo base64_encode(random_bytes(32)).PHP_EOL;"</code>
        </div>
    {% endif %}

    {{ form_start(form) }}
        <div class="card mb-3">
            <div class="card-header py-2 fw-semibold">Příchozí pošta (IMAP)</div>
            <div class="card-body">
                <p class="text-muted small mb-3">
                    Automatizační schránka, do které chodí e-maily portálů a oznámení banky.
                    Aplikace je čte a zakládá z nich rezervace a platby.
                </p>
                <div class="row g-3">
                    <div class="col-md-6">{{ form_row(form.imapHost) }}</div>
                    <div class="col-md-3">{{ form_row(form.imapPort) }}</div>
                    <div class="col-md-3">{{ form_row(form.imapEncryption) }}</div>
                </div>
                <div class="row g-3 mt-0">
                    <div class="col-md-6">{{ form_row(form.imapUsername) }}</div>
                    <div class="col-md-6">{{ form_row(form.imapFolder) }}</div>
                </div>
                <div class="mt-3">
                    {{ form_row(form.imapPassword) }}
                    {% if secretsSet.imapPassword %}<span class="badge text-bg-success">heslo nastaveno</span>{% else %}<span class="badge text-bg-secondary">heslo nenastaveno</span>{% endif %}
                </div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header py-2 fw-semibold">Odchozí pošta (SMTP)</div>
            <div class="card-body">
                <p class="text-muted small mb-3">
                    Odesílání zpráv hostům, faktur a notifikací. Dokud tu server není,
                    aplikace nemá kudy poštu poslat a nic neodejde.
                </p>
                <div class="row g-3">
                    <div class="col-md-6">{{ form_row(form.smtpHost) }}</div>
                    <div class="col-md-3">{{ form_row(form.smtpPort) }}</div>
                    <div class="col-md-3">{{ form_row(form.smtpEncryption) }}</div>
                </div>
                <div class="row g-3 mt-0">
                    <div class="col-md-6">{{ form_row(form.smtpUsername) }}</div>
                    <div class="col-md-6">
                        {{ form_row(form.smtpPassword) }}
                        {% if secretsSet.smtpPassword %}<span class="badge text-bg-success">heslo nastaveno</span>{% else %}<span class="badge text-bg-secondary">heslo nenastaveno</span>{% endif %}
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end">
            <button type="submit" class="btn btn-primary">Uložit</button>
        </div>
    {{ form_end(form) }}
{% endblock %}
