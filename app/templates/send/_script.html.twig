{# Chování oken „Poslat" (send/_modal.html.twig). Vložit jednou na stránku. #}
<script>
    (function () {
        function post(url, fields) {
            const body = new FormData();
            Object.keys(fields).forEach(function (key) { body.append(key, fields[key]); });
            // sendBeacon přežije i odchod stránky do WhatsAppu nebo SMS.
            navigator.sendBeacon(url, body);
        }

        document.querySelectorAll('[data-send-modal]').forEach(function (modal) {
            const createButton = modal.querySelector('[data-text-create]');
            const error = modal.querySelector('[data-text-error]');
            const result = modal.querySelector('[data-text-result]');
            const text = modal.querySelector('[data-text]');
            const whatsapp = modal.querySelector('[data-channel="whatsapp"]');
            const sms = modal.querySelector('[data-channel="sms"]');
            const phoneMissing = modal.querySelector('[data-phone-missing]');
            let prepared = null;
            let changed = false;

            // Náhled e-mailu se načte až při rozbalení.
            const preview = modal.querySelector('[data-email-preview]');
            if (preview) {
                preview.addEventListener('toggle', async function () {
                    if (!preview.open || preview.dataset.loaded) return;
                    preview.dataset.loaded = '1';
                    const frame = preview.querySelector('iframe');
                    try {
                        const res = await fetch(preview.dataset.url);
                        if (!res.ok) throw new Error(res.status);
                        const data = await res.json();
                        preview.querySelector('[data-email-preview-subject]').textContent = 'Předmět: ' + data.subject;
                        frame.srcdoc = data.html;
                    } catch (e) {
                        frame.srcdoc = '<p style="font-family:sans-serif;color:#b00">Náhled se nepodařilo načíst.</p>';
                    }
                });
            }

            // Odkazy na WhatsApp a SMS nesou aktuální (třeba upravený) text.
            function refreshChannelLinks() {
                if (!prepared) return;
                const message = encodeURIComponent(text.value);
                if (prepared.whatsapp) whatsapp.href = prepared.whatsapp + '?text=' + message;
                if (prepared.sms) sms.href = prepared.sms + '?body=' + message;
            }

            // Zapíše kanál k odkazu na fakturu a uzavře akci na časové ose, pokud k ní okno patří.
            function recordChannel(channel) {
                if (prepared && prepared.sentUrl) {
                    post(prepared.sentUrl, {_token: modal.dataset.linkSentToken, channel: channel});
                }
                if (modal.dataset.actionSentUrl) {
                    post(modal.dataset.actionSentUrl, {_token: modal.dataset.actionToken, channel: channel});
                }
                changed = true;
            }

            createButton.addEventListener('click', async function () {
                createButton.disabled = true;
                error.hidden = true;
                const body = new FormData();
                body.append('_token', modal.dataset.textToken);
                try {
                    const res = await fetch(modal.dataset.textUrl, {method: 'POST', body: body});
                    const data = await res.json();
                    if (!res.ok) throw new Error(data.error || '');
                    prepared = data;
                    changed = true;
                    text.value = data.text;
                    whatsapp.hidden = !data.whatsapp;
                    sms.hidden = !data.sms;
                    phoneMissing.hidden = !!data.whatsapp;
                    refreshChannelLinks();
                    result.hidden = false;
                    createButton.hidden = true;
                } catch (e) {
                    error.textContent = e.message || 'Zprávu se nepodařilo připravit.';
                    error.hidden = false;
                    createButton.disabled = false;
                }
            });

            text.addEventListener('input', refreshChannelLinks);

            modal.querySelectorAll('[data-channel]').forEach(function (el) {
                el.addEventListener('click', function () {
                    if (!prepared) return;
                    const channel = el.dataset.channel;
                    if (channel === 'copy') {
                        navigator.clipboard.writeText(text.value).then(function () {
                            const orig = el.textContent;
                            el.textContent = 'Zkopírováno';
                            setTimeout(function () { el.textContent = orig; }, 1500);
                        });
                    }
                    recordChannel(channel);
                });
            });

            // Nový odkaz i uzavřená akce se ukážou po zavření okna.
            modal.addEventListener('hidden.bs.modal', function () {
                if (changed) window.location.reload();
            });

            // Sdílení souboru umí jen některé prohlížeče (hlavně v telefonu). PDF se
            // stáhne předem, protože sdílení musí začít přímo po klepnutí.
            if (!modal.dataset.pdfUrl) return;
            const share = modal.querySelector('[data-share-pdf]');
            const shareButton = modal.querySelector('[data-share-pdf-button]');
            const probe = new File([''], modal.dataset.pdfName, {type: 'application/pdf'});
            if (!navigator.canShare || !navigator.canShare({files: [probe]})) return;
            share.hidden = false;
            let file = null;
            modal.addEventListener('shown.bs.modal', async function () {
                if (file) return;
                try {
                    const res = await fetch(modal.dataset.pdfUrl);
                    if (!res.ok) throw new Error(res.status);
                    file = new File([await res.blob()], modal.dataset.pdfName, {type: 'application/pdf'});
                    shareButton.disabled = false;
                } catch (e) {
                    share.hidden = true;
                }
            });
            shareButton.addEventListener('click', function () {
                navigator.share({files: [file]}).then(function () {
                    if (modal.dataset.actionSentUrl) {
                        post(modal.dataset.actionSentUrl, {_token: modal.dataset.actionToken, channel: 'file'});
                        changed = true;
                    }
                }).catch(function () {});
            });
        });
    })();
</script>
