{# Rozbalovací náhled e-mailu do okna „Poslat". Očekává: preview_url. #}
<details class="mb-2" data-email-preview data-url="{{ preview_url }}">
    <summary class="small">Náhled e-mailu</summary>
    <p class="small text-muted my-2" data-email-preview-subject></p>
    <iframe title="Náhled e-mailu hostovi" style="width:100%; height:50vh; border:1px solid var(--bs-border-color); border-radius:6px; background:#fff;"></iframe>
</details>
