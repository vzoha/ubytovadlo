{# Okno „Poslat připomínku doplatku" k akci na časové ose. Očekává: action, reservation. #}
{% set contact = reservation.guestContact %}
{% set invoice = balance_invoice(reservation) %}
{% set has_pdf = invoice and invoice.pdfPath %}
{% embed 'send/_modal.html.twig' with {
    modal_id: 'sendReminder' ~ action.id,
    title: 'Poslat připomínku doplatku',
    text_url: path('balance_reminder_text', {id: action.id}),
    text_token: csrf_token('action-edit-' ~ action.id),
    create_label: 'Připravit zprávu',
    text_intro: has_pdf
        ? 'Připraví text připomínky s platebními údaji a odkazem na fakturu ' ~ invoice.number ~ ' (odkaz platí ' ~ constant('App\\Invoice\\InvoiceLinks::LIFETIME_DAYS') ~ ' dní). Po odeslání se připomínka na časové ose uzavře.'
        : 'Připraví text připomínky s platebními údaji. Faktura na doplatek zatím není vystavená, zpráva bude bez odkazu. Po odeslání se připomínka na časové ose uzavře.',
    pdf_url: has_pdf ? path('invoice_pdf', {id: invoice.id}) : null,
    pdf_name: has_pdf ? invoice.number ~ '.pdf' : null,
    action_sent_url: path('balance_reminder_sent', {id: action.id}),
    action_token: csrf_token('action-edit-' ~ action.id),
} %}
    {% block email %}
        {% if contact.hasEmail %}
            <p class="small mb-2">Připomínka ze šablony <em>Připomínka doplatku</em> odejde na <strong>{{ contact.deliveryEmail }}</strong>.</p>
            {% include 'send/_email_preview.html.twig' with {preview_url: path('reservation_action_preview', {id: action.id})} %}
            <form method="post" action="{{ path('reservation_action_send', {id: action.id}) }}"
                  onsubmit="return confirm('Poslat připomínku doplatku na {{ contact.deliveryEmail|e('js') }}?');">
                <input type="hidden" name="_token" value="{{ csrf_token('action-edit-' ~ action.id) }}">
                <button class="btn btn-sm btn-primary">Poslat e-mailem</button>
            </form>
        {% else %}
            <p class="small text-muted mb-0">Rezervace nemá e-mail hosta.</p>
        {% endif %}
    {% endblock %}
{% endembed %}
