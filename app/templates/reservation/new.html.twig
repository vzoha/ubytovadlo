{% extends 'base.html.twig' %}

{% block title %}Nová rezervace{% endblock %}

{% block body %}
    <h1 class="h3 mb-1">Nová rezervace</h1>
    <p class="text-muted">Přímý host — telefon, e-mail nebo osobně. Vyplňte, co víte; zbytek (adresa, faktura, zprávy) jde doplnit z detailu.</p>

    {% if prefill_customer %}
        <div class="alert alert-info d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span>
                Předvyplněno z posledního pobytu hosta
                <a href="{{ path('customer_detail', {id: prefill_customer.id}) }}" class="alert-link">{{ prefill_customer.displayName ?? ('Host #' ~ prefill_customer.id) }}</a>.
                {% if prefill_customer.note %}<br><span class="small">Poznámka: {{ prefill_customer.note }}</span>{% endif %}
            </span>
            <a href="{{ path('reservation_new') }}" class="text-decoration-none small">Vyplnit jiného hosta</a>
        </div>
    {% else %}
        <div class="card mb-3">
            <div class="card-body">
                <form method="get" action="{{ path('reservation_new') }}" class="d-flex flex-wrap align-items-end gap-2" role="search">
                    <div class="flex-grow-1">
                        <label for="hostSearch" class="form-label small mb-0">Host tu už byl? Najděte ho a údaje se předvyplní.</label>
                        <input id="hostSearch" type="search" name="najit" value="{{ host_search }}" class="form-control form-control-sm" placeholder="Jméno, e-mail, telefon">
                    </div>
                    <button type="submit" class="btn btn-sm btn-outline-secondary">Hledat</button>
                </form>
                {% if host_search %}
                    <ul class="list-unstyled mb-0 mt-2">
                        {% for row in host_matches %}
                            <li class="d-flex flex-wrap gap-2 align-items-baseline">
                                <a href="{{ path('reservation_new', {host: row.customer.id}) }}" class="text-decoration-none">{{ row.customer.displayName ?? ('Host #' ~ row.customer.id) }} →</a>
                                <span class="text-muted small">{{ row.customer.email ?? '' }} · naposledy {{ row.lastCheckIn|date('d. m. Y') }}</span>
                            </li>
                        {% else %}
                            <li class="text-muted small">Žádný host neodpovídá hledání „{{ host_search }}“.</li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </div>
        </div>
    {% endif %}

    {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
    <div class="row g-3">
        <div class="col-md-12"><h6 class="text-muted mb-0">Rezervace</h6></div>
        <div class="col-md-6">{{ form_row(form.guestName) }}</div>
        <div class="col-md-3">{{ form_row(form.checkIn) }}</div>
        <div class="col-md-3">{{ form_row(form.checkOut) }}</div>
        <div class="col-md-3">{{ form_row(form.guestsAdult) }}</div>
        <div class="col-md-3">{{ form_row(form.guestsChild) }}</div>

        <div class="col-md-12"><hr><h6 class="text-muted mb-0">Cena a fakturace</h6></div>
        <div class="col-md-4">{{ form_row(form.priceTotal) }}</div>
        <div class="col-md-8">{{ form_row(form.billingMode) }}</div>

        <div class="col-md-12"><hr><h6 class="text-muted mb-0">Kontakt</h6></div>
        <div class="col-md-6">{{ form_row(form.guestContact.email) }}</div>
        <div class="col-md-6">{{ form_row(form.guestContact.phone) }}</div>

        <div class="col-md-12"><hr><h6 class="text-muted mb-0">Fakturační adresa <span class="fw-normal">(pro fakturu; lze doplnit později)</span></h6></div>
        <div class="col-md-6">{{ form_row(form.guestAddress.street) }}</div>
        <div class="col-md-2">{{ form_row(form.guestAddress.zip) }}</div>
        <div class="col-md-4">{{ form_row(form.guestAddress.city) }}</div>
        <div class="col-md-4">{{ form_row(form.guestAddress.country) }}</div>
        <div class="col-md-4">{{ form_row(form.guestLocale) }}</div>

        <div class="col-md-12"><hr><h6 class="text-muted mb-0">Firma <span class="fw-normal">(pokud chce host fakturovat na firmu)</span></h6></div>
        <div class="col-md-6">{{ form_row(form.guestBilling.companyName) }}</div>
        <div class="col-md-3">{{ form_row(form.guestBilling.ico) }}</div>
        <div class="col-md-3">{{ form_row(form.guestBilling.dic) }}</div>

        <div class="col-md-12"><hr><h6 class="text-muted mb-0">Doplňky</h6></div>
        <div class="col-md-3 d-flex align-items-center">{{ form_row(form.hasPet) }}</div>
        <div class="col-md-9">{{ form_row(form.petsNote) }}</div>
        <div class="col-md-12 d-flex align-items-center">{{ form_row(form.needsBabyCot) }}</div>
        <div class="col-md-12">{{ form_row(form.notes) }}</div>
        <div class="col-md-12">{{ form_row(form.acquisitionSource) }}</div>
    </div>
    <datalist id="acquisition-sources">
        <option value="Booking">
        <option value="Airbnb">
        <option value="Web">
        <option value="Facebook">
        <option value="Návrat">
        <option value="E-chalupy">
        <option value="CS-chalupy">
        <option value="Kudyznudy">
        <option value="Doporučení">
        <option value="Neznámo">
    </datalist>
    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Přidat rezervaci</button>
        <a href="{{ path('reservation_list') }}" class="btn btn-outline-secondary">Zrušit</a>
    </div>
    {{ form_end(form) }}
{% endblock %}
