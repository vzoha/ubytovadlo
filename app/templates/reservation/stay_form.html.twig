{% extends 'base.html.twig' %}

{% block title %}Termín a cena — rezervace #{{ reservation.id }}{% endblock %}

{% block body %}
    <a href="{{ path('reservation_detail', {id: reservation.id}) }}" class="text-decoration-none small">← {{ reservation.guestName ?? ('Rezervace #' ~ reservation.id) }}</a>
    <h1 class="h3 mb-3 mt-1">{{ reservation.channel.ownsStay ? 'Upravit termín a cenu' : 'Upravit cenu' }}</h1>

    {{ form_start(form) }}
        {{ include('reservation/_stay_fields.html.twig') }}
        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">Uložit</button>
            <a href="{{ path('reservation_detail', {id: reservation.id}) }}" class="btn btn-outline-secondary">Zrušit</a>
        </div>
    {{ form_end(form) }}
{% endblock %}
