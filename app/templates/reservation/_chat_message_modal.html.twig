{#
    Text zprávy hostovi k vložení do chatu portálu nebo k odeslání přes WhatsApp či SMS.
    Otevřený z akce na ose nabídne text automatické zprávy; odeslání telefonem akci uzavře.
    Očekává: reservation, quick_messages, payment_messages, extranet, phone.
#}
<div class="modal fade" id="chatMessage" tabindex="-1" aria-labelledby="chatMessageLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h6 mb-0" id="chatMessageLabel">Zpráva hostovi</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zavřít"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small">Šablona se vyplní údaji této rezervace. Text jde před odesláním upravit.</p>

                <label class="form-label" for="chat-message-template">Šablona</label>
                <select class="form-select form-select-sm mb-2" id="chat-message-template" data-chat-templates="{{ quick_messages|json_encode }}">
                    {% for m in quick_messages %}
                        <option value="{{ loop.index0 }}">{{ m.label }}</option>
                    {% endfor %}
                    {# Text s odkazem na fakturu složí server až při výběru. #}
                    {% for m in payment_messages %}
                        <option value="payment-{{ loop.index0 }}" data-url="{{ m.url }}" data-token="{{ m.token }}">{{ m.label }}</option>
                    {% endfor %}
                </select>

                <label class="form-label" for="chat-message-text">Text</label>
                <textarea class="form-control" id="chat-message-text" rows="8">{{ quick_messages is not empty ? quick_messages|first.text }}</textarea>
            </div>
            <div class="modal-footer justify-content-between">
                {% if extranet %}
                    <a href="{{ extranet }}" target="_blank" rel="noopener" class="text-decoration-none small">Otevřít chat v {{ reservation.channel.label }} ↗</a>
                {% else %}
                    <span></span>
                {% endif %}
                <span class="d-flex flex-wrap gap-2 justify-content-end">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Zavřít</button>
                    {% if phone|default %}
                        <a class="btn btn-outline-success" href="#" target="_blank" rel="noopener"
                           data-send-channel="whatsapp" data-send-base="https://wa.me/{{ phone.whatsapp }}?text=">WhatsApp ↗</a>
                        <a class="btn btn-outline-primary" href="#" data-send-channel="sms" data-send-base="sms:{{ phone.e164 }}?body=">SMS</a>
                    {% endif %}
                    <button type="button" class="btn btn-primary" data-copy="#chat-message-text">Zkopírovat</button>
                    {# Zpráva z časové osy se po vložení do chatu rovnou uzavře. #}
                    <form method="post" data-chat-done hidden>
                        <input type="hidden" name="_token" value="">
                        <button type="button" class="btn btn-outline-success" data-chat-copy-done>Zkopírovat a označit hotové</button>
                    </form>
                </span>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        const modal = document.getElementById('chatMessage');
        const select = modal.querySelector('#chat-message-template');
        const text = modal.querySelector('#chat-message-text');
        const doneForm = modal.querySelector('[data-chat-done]');
        const doneButton = modal.querySelector('[data-chat-copy-done]');
        const quick = JSON.parse(select.dataset.chatTemplates);
        const sendLinks = modal.querySelectorAll('[data-send-channel]');
        const ACTION = 'action';
        let actionText = '';
        let actionId = null;

        // Odkaz do WhatsAppu a SMS nese vždy aktuální text, i po ruční úpravě.
        function syncSendLinks() {
            sendLinks.forEach(function (link) {
                link.href = link.dataset.sendBase + encodeURIComponent(text.value);
            });
        }
        text.addEventListener('input', syncSendLinks);

        // Zprávu o platbě (vytvoří odkaz na fakturu) načte až výběr v seznamu, ne otevření okna.
        async function fill(chosen) {
            if (select.value === ACTION) {
                text.value = actionText;
                syncSendLinks();
                return;
            }
            const option = select.selectedOptions[0];
            if (!option || !option.dataset.url) {
                text.value = option ? quick[select.value].text : '';
                syncSendLinks();
                return;
            }
            if (!chosen) {
                text.value = '';
                syncSendLinks();
                return;
            }
            text.value = '…';
            const body = new FormData();
            body.append('_token', option.dataset.token);
            body.append('channel', 'copy');
            try {
                const res = await fetch(option.dataset.url, {method: 'POST', body: body});
                const data = await res.json();
                text.value = res.ok ? data.text : (data.error || 'Text se nepodařilo připravit.');
            } catch (e) {
                text.value = 'Text se nepodařilo připravit.';
            }
            syncSendLinks();
        }

        function dropActionOption() {
            const option = select.querySelector('option[value="' + ACTION + '"]');
            if (option) option.remove();
        }

        select.addEventListener('change', function () { fill(true); });

        modal.addEventListener('show.bs.modal', async function (event) {
            const source = event.relatedTarget ? event.relatedTarget.dataset : {};
            dropActionOption();
            doneForm.hidden = true;
            actionId = source.actionId || null;
            select.selectedIndex = 0;
            fill();

            if (!source.messageUrl) {
                return;
            }

            // Ruční uzavření po zkopírování dává smysl jen u chatu portálu.
            if (source.doneUrl) {
                doneForm.action = source.doneUrl;
                doneForm.querySelector('input[name="_token"]').value = source.doneToken;
                doneForm.hidden = false;
            }

            try {
                const res = await fetch(source.messageUrl);
                if (!res.ok) throw new Error(res.status);
                const data = await res.json();
                actionText = data.text;
                select.prepend(new Option(data.label, ACTION, true, true));
                fill();
            } catch (e) {
                // Text akce se nenačetl — zůstávají rychlé zprávy.
            }
        });

        // Text akce odeslaný telefonem akci uzavře, rychlá zpráva zastupující automatickou
        // zprávu uzavře akci svého druhu; ostatní se zapíše na osu jako zpráva.
        sendLinks.forEach(function (link) {
            link.addEventListener('click', function () {
                if (!window.recordSentMessage) return;
                if (select.value === ACTION) {
                    window.recordSentMessage(link.dataset.sendChannel, select.selectedOptions[0].textContent, null, actionId);
                    return;
                }
                const message = quick[select.value];
                window.recordSentMessage(link.dataset.sendChannel, select.selectedOptions[0].textContent, message ? message.kind : null, null);
            });
        });

        // Zkopírovaná šablona se zapíše na časovou osu; zpráva akce se zapíše uzavřením akce.
        modal.querySelector('[data-copy="#chat-message-text"]').addEventListener('click', function () {
            if (select.value !== ACTION && window.recordSentMessage) {
                window.recordSentMessage('copy', select.selectedOptions[0].textContent);
            }
        });

        doneButton.addEventListener('click', function () {
            navigator.clipboard.writeText(text.value).then(function () {
                doneForm.submit();
            }).catch(function () {
                // Schránka není k dispozici — text zůstane vybraný ke zkopírování ručně.
                text.select();
            });
        });
    })();
</script>
