{# Okno „Poslat fakturu". Očekává: invoice, reservation. #}
{% set contact = reservation.guestContact %}
{% embed 'send/_modal.html.twig' with {
    modal_id: 'sendInvoice' ~ invoice.id,
    title: 'Poslat fakturu ' ~ invoice.number,
    text_url: path('invoice_link_create', {id: invoice.id}),
    text_token: csrf_token('invoice-link-' ~ invoice.id),
    create_label: 'Vytvořit odkaz',
    text_intro: 'Vytvoří odkaz na PDF platný ' ~ constant('App\\Invoice\\InvoiceLinks::LIFETIME_DAYS') ~ ' dní a k němu text zprávy. Kdo odkaz má, fakturu otevře — posílejte ho jen hostovi.',
    pdf_url: path('invoice_pdf', {id: invoice.id}),
    pdf_name: invoice.number ~ '.pdf',
} %}
    {% block email %}
        {% if contact.hasEmail %}
            <p class="small mb-2">
                PDF odejde v příloze na <strong>{{ contact.deliveryEmail }}</strong>.
                {% if contact.deliversToPortal %}<span class="text-warning-emphasis">Je to adresa portálu — přílohu nemusí propustit.</span>{% endif %}
            </p>
            {% include 'send/_email_preview.html.twig' with {preview_url: path('invoice_message_preview', {id: invoice.id})} %}
            <form method="post" action="{{ path('invoice_send_email', {id: invoice.id}) }}"
                  onsubmit="return confirm('Poslat fakturu {{ invoice.number }} na {{ contact.deliveryEmail|e('js') }}?');">
                <input type="hidden" name="_token" value="{{ csrf_token('invoice-email-' ~ invoice.id) }}">
                <button class="btn btn-sm btn-primary">Poslat e-mailem</button>
            </form>
        {% else %}
            <p class="small text-muted mb-0">Rezervace nemá e-mail hosta.</p>
        {% endif %}
    {% endblock %}
    {% block extra %}
        {% set links = invoice_links(invoice) %}
        {% if links is not empty %}
            <hr>
            <h3 class="h6">Vytvořené odkazy</h3>
            <ul class="list-group list-group-flush small">
                {% for item in links %}
                    {% set link = item.link %}
                    <li class="list-group-item px-0 d-flex flex-wrap gap-2 justify-content-between align-items-center">
                        <span class="{{ item.active ? '' : 'text-muted' }}">
                            {{ link.createdAt|date('d. m. Y') }}{% if link.channel %} · {{ link.channel.label }}{% endif %}
                            ·
                            {% if link.revokedAt %}zrušen {{ link.revokedAt|date('d. m. Y') }}
                            {% elseif item.active %}platí do {{ link.expiresAt|date('d. m. Y') }}
                            {% else %}vypršel {{ link.expiresAt|date('d. m. Y') }}{% endif %}
                            {% if link.lastOpenedAt %} · naposledy otevřen {{ link.lastOpenedAt|date('d. m. Y H:i') }}{% endif %}
                        </span>
                        {% if item.active %}
                            <form method="post" action="{{ path('invoice_link_revoke', {id: link.id}) }}"
                                  onsubmit="return confirm('Zrušit odkaz? Host fakturu přes něj už neotevře.');">
                                <input type="hidden" name="_token" value="{{ csrf_token('invoice-link-revoke-' ~ link.id) }}">
                                <button class="btn btn-sm btn-outline-danger">Zrušit</button>
                            </form>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    {% endblock %}
{% endembed %}
