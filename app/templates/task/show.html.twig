{% extends 'base.html.twig' %}

{% block title %}{{ task.name }} — {{ brand_name }}{% endblock %}

{% block body %}
    {% set urgency = task.urgencyAt(today) %}
    {% set days = task.daysUntilDue(today) %}
    <a class="text-decoration-none small" href="{{ path('task_index') }}">← Termíny</a>
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4 mt-1">
        <h1 class="h3 mb-0">{{ task.name }}</h1>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#modalComplete">+ Provedeno</button>
            <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#modalEdit">✎ Upravit</button>
            <form method="post" action="{{ path('task_delete', {id: task.id}) }}" onsubmit="return confirm('Smazat termín i s historií provedení?')">
                <input type="hidden" name="_token" value="{{ csrf_token('task-delete-' ~ task.id) }}">
                <button class="btn btn-sm btn-outline-danger">Smazat</button>
            </form>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-12 col-md-4">
            <div class="card h-100">
                <div class="card-body py-3">
                    <div class="text-muted small">Příští termín</div>
                    <div class="fs-4 fw-bold">{{ task.dueOn ? task.dueOn|date('j. n. Y') : 'nezadán' }}</div>
                    <span class="badge text-bg-{{ urgency.badge }}">{{ urgency.label }}</span>
                    {% if days is not null %}
                        <span class="small text-muted">{{ days == 0 ? 'dnes' : (days > 0 ? 'za ' ~ days ~ ' dní' : 'před ' ~ (days * -1) ~ ' dny') }}</span>
                    {% endif %}
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card h-100">
                <div class="card-body py-3 small">
                    <div><span class="text-muted">Kategorie:</span> {{ task.category.label }}</div>
                    <div><span class="text-muted">Opakování:</span> {{ task.recurrence.label }}, {{ task|task_interval }}</div>
                    <div><span class="text-muted">Upozornit předem:</span> {{ task.leadDays }} dní</div>
                    <div><span class="text-muted">Naposledy provedeno:</span> {{ task.lastDoneOn ? task.lastDoneOn|date('j. n. Y') : '—' }}</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card h-100">
                <div class="card-body py-3 small">
                    <div><span class="text-muted">Kdo úkon dělá:</span> {{ task.vendor ?: '—' }}</div>
                    <div><span class="text-muted">Kontakt:</span> {{ task.vendorContact ?: '—' }}</div>
                    <div><span class="text-muted">Předpis:</span> {{ task.legalReference ?: '—' }}</div>
                    <div><span class="text-muted">Odhad ceny:</span> {{ task.estimatedCostCzk is not null ? task.estimatedCostCzk|number_format(0, ',', ' ') ~ ' Kč' : '—' }}</div>
                </div>
            </div>
        </div>
    </div>

    {% if task.note %}
        <div class="card mb-4"><div class="card-body py-2 small">{{ task.note|nl2br }}</div></div>
    {% endif %}

    <h2 class="h5 mb-2">Historie provedení</h2>
    <div class="card">
        <div class="table-responsive">
        <table class="table table-sm table-hover align-middle mb-0 small">
            <thead>
                <tr><th>Datum</th><th>Kdo</th><th class="text-end">Cena</th><th>Platnost do</th><th>Protokol</th><th>Poznámka</th><th></th></tr>
            </thead>
            <tbody>
            {% for c in completions %}
                <tr>
                    <td>{{ c.doneOn|date('j. n. Y') }}</td>
                    <td>{{ c.vendor ?: '—' }}</td>
                    <td class="text-end">
                        {{ c.costCzk is not null ? c.costCzk|number_format(0, ',', ' ') ~ ' Kč' : '—' }}
                        {% if c.ledgerEntry %}<span class="badge text-bg-light">v cashflow</span>{% endif %}
                    </td>
                    <td>{{ c.validUntil ? c.validUntil|date('j. n. Y') : '—' }}</td>
                    <td>
                        {% if c.hasAttachment %}
                            <a class="text-decoration-none" href="{{ path('task_attachment_download', {id: c.id}) }}" target="_blank" rel="noopener">{{ c.attachmentName }} ↗</a>
                        {% else %}—{% endif %}
                    </td>
                    <td class="text-muted">{{ c.note }}</td>
                    <td class="text-end">
                        <form method="post" action="{{ path('task_completion_delete', {id: c.id}) }}" onsubmit="return confirm('Smazat provedení? Smaže se i protokol a výdaj z cashflow.')">
                            <input type="hidden" name="_token" value="{{ csrf_token('task-completion-delete-' ~ c.id) }}">
                            <button class="btn btn-sm btn-outline-danger py-0">×</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr class="table-empty"><td colspan="7" class="text-muted">Zatím žádné provedení.</td></tr>
            {% endfor %}
            </tbody>
        </table>
        </div>
    </div>

    <div class="modal fade" id="modalComplete" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <form method="post" action="{{ path('task_complete', {id: task.id}) }}" enctype="multipart/form-data" class="modal-content">
                <input type="hidden" name="_token" value="{{ csrf_token('task-complete-' ~ task.id) }}">
                <div class="modal-header"><h2 class="h5 modal-title">Zápis provedení</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zavřít"></button></div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label" for="done-on">Datum provedení</label>
                            <input type="date" class="form-control" id="done-on" name="done_on" value="{{ today|date('Y-m-d') }}" required>
                        </div>
                        <div class="col-6">
                            <label class="form-label" for="valid-until">Platnost do</label>
                            <input type="date" class="form-control" id="valid-until" name="valid_until">
                            <div class="form-text">Datum z protokolu. Vyplněné určí příští termín.</div>
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="done-vendor">Kdo úkon udělal</label>
                            <input type="text" class="form-control" id="done-vendor" name="vendor" maxlength="120" value="{{ task.vendor }}">
                        </div>
                        <div class="col-6">
                            <label class="form-label" for="done-cost">Cena</label>
                            <div class="input-group">
                                <input type="number" class="form-control" id="done-cost" name="cost" min="0" step="1"
                                       value="{{ task.estimatedCostCzk is not null ? task.estimatedCostCzk : '' }}">
                                <span class="input-group-text">Kč</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <label class="form-label" for="book-account">Zaúčtovat jako výdaj</label>
                            <select class="form-select" id="book-account" name="book_account">
                                <option value="0">Jen evidovat cenu</option>
                                {% for a in accounts %}<option value="{{ a.id }}">{{ a.name }}</option>{% endfor %}
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="attachment">Protokol</label>
                            <input type="file" class="form-control" id="attachment" name="attachment" accept=".pdf,.jpg,.jpeg,.png">
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="done-note">Poznámka</label>
                            <textarea class="form-control" id="done-note" name="note" rows="2"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Zrušit</button>
                    <button type="submit" class="btn btn-primary">Uložit</button>
                </div>
            </form>
        </div>
    </div>

    <div class="modal fade" id="modalEdit" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <form method="post" action="{{ path('task_update', {id: task.id}) }}" class="modal-content">
                <input type="hidden" name="_token" value="{{ csrf_token('task-edit-' ~ task.id) }}">
                <div class="modal-header"><h2 class="h5 modal-title">Upravit termín</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zavřít"></button></div>
                <div class="modal-body">{% include 'task/_form_fields.html.twig' with {prefix: 'edit', task: task} %}</div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Zrušit</button>
                    <button type="submit" class="btn btn-primary">Uložit</button>
                </div>
            </form>
        </div>
    </div>
{% endblock %}
