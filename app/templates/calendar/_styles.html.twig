<style>
    /* Kalendář: sloupec = den, řádek = jednotka. Šířka sloupce drží čitelnost,
       při užším okně se osa posouvá uvnitř svého rámečku, ne celá stránka. */
    .cal { --cal-col: 2.4rem; --cal-label: 8rem; --cal-lane: 1.85rem; }
    .cal-scroll { overflow-x: auto; }
    /* Šířku drží počet dnů, ne obsah pásů — jinak by jeden dlouhý popisek roztáhl
       všechny sloupce. Obsah se posouvá uvnitř rámečku, stránka zůstává bez vodorovného posuvu. */
    .cal-body { width: calc(var(--cal-label) + var(--cal-days) * var(--cal-col)); min-width: 100%; }
    .cal-body--fill { width: 100%; }

    .cal-row { display: grid; grid-template-columns: var(--cal-label) 1fr; align-items: stretch; }
    .cal-label {
        position: sticky;
        left: 0;
        z-index: 3;
        display: flex;
        align-items: center;
        padding: .25rem .5rem;
        background: #fff;
        border-right: 1px solid var(--bs-border-color);
        font-size: .8125rem;
        line-height: 1.2;
    }
    .cal-track { position: relative; min-width: 0; }

    /* Podklad se sloupci dnů — víkend a dnešek se barví tady, obsah leží nad ním. */
    .cal-cells {
        position: absolute;
        inset: 0;
        display: grid;
        grid-template-columns: repeat(var(--cal-days), minmax(0, 1fr));
    }
    .cal-cell { border-right: 1px solid var(--bs-border-color); }
    .cal-cell:last-child { border-right: 0; }
    .cal-cell--weekend { background: var(--bs-tertiary-bg); }
    .cal-cell--outside { background: repeating-linear-gradient(45deg, var(--bs-tertiary-bg) 0 3px, transparent 3px 6px); }
    .cal-cell--today { background: rgba(var(--bs-primary-rgb), .12); box-shadow: inset 0 0 0 1px rgba(var(--bs-primary-rgb), .45); }

    .cal-days, .cal-numbers, .cal-markers {
        position: relative;
        display: grid;
        grid-template-columns: repeat(var(--cal-days), minmax(0, 1fr));
    }
    .cal-days > div { padding: .15rem 0 .25rem; text-align: center; line-height: 1.1; }
    .cal-days .cal-dow { display: block; font-size: .6875rem; color: var(--bs-secondary-color); }
    .cal-days .cal-num { font-size: .8125rem; }
    .cal-days .cal-num--today { font-weight: 700; color: var(--bs-primary); }
    .cal-numbers > div { padding: .15rem .25rem 0; font-size: .8125rem; }

    .cal-lanes { position: relative; padding: .1rem 0; }
    .cal-lane { position: relative; height: var(--cal-lane); }

    .cal-bar {
        position: absolute;
        top: .15rem;
        bottom: .15rem;
        display: flex;
        align-items: center;
        overflow: hidden;
        padding: 0 .4rem;
        border-radius: .75rem;
        background: var(--cal-bar-color, var(--bs-secondary));
        color: #fff;
        font-size: .75rem;
        line-height: 1;
        text-decoration: none;
        white-space: nowrap;
    }
    .cal-bar:hover { color: #fff; filter: brightness(1.08); }
    .cal-bar__label { overflow: hidden; text-overflow: ellipsis; }
    /* Pobyt pokračuje za okraj okna — na té straně se pás nezakulacuje. */
    .cal-bar--open-start { border-top-left-radius: 0; border-bottom-left-radius: 0; }
    .cal-bar--open-end { border-top-right-radius: 0; border-bottom-right-radius: 0; }
    /* Rezervace bez údajů hosta: termín blokuje, ale ještě není hotová. */
    .cal-bar--unconfirmed { background-image: repeating-linear-gradient(45deg, rgba(255, 255, 255, .3) 0 4px, transparent 4px 8px); }
    /* Dvojí prodej: pásy jsou v samostatných drahách nad sebou a oba mají červený rám. */
    .cal-bar--conflict { box-shadow: 0 0 0 2px var(--bs-danger); }

    .cal-bar--web { --cal-bar-color: #0d6efd; }
    .cal-bar--direct { --cal-bar-color: #12805c; }
    .cal-bar--booking { --cal-bar-color: #1a4f9c; }
    .cal-bar--airbnb { --cal-bar-color: #d6455d; }
    .cal-bar--echalupy { --cal-bar-color: #b3541e; }
    .cal-bar--cs_chalupy { --cal-bar-color: #6f42c1; }

    .cal-markers > div { min-width: 0; display: flex; flex-wrap: wrap; gap: .15rem; padding: .15rem .1rem; min-height: 1.4rem; }
    .cal-marker {
        display: inline-flex;
        align-items: center;
        gap: .2rem;
        min-width: 0;
        max-width: 100%;
        padding: .05rem .3rem;
        border-radius: .5rem;
        font-size: .6875rem;
        line-height: 1.3;
        text-decoration: none;
    }
    .cal-marker__label { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    /* Na ose zabírá bod celý sloupec: úklid ani revize se neplánují na hodinu,
       patří ke dni. Popisek se do šířky dne nevejde, zůstane ikona a tooltip. */
    .cal-markers--icons > div { padding-left: 0; padding-right: 0; }
    .cal-markers--icons .cal-marker { flex: 1 0 100%; justify-content: center; }
    .cal-markers--icons .cal-marker__label { display: none; }

    .cal-week { position: relative; min-height: 3.5rem; border: 1px solid var(--bs-border-color); border-radius: .5rem; overflow: hidden; }
    .cal-week + .cal-week { margin-top: .5rem; }
    .cal-week .cal-lanes { min-height: var(--cal-lane); }
    .cal-week-unit { padding: .1rem .4rem 0; font-size: .6875rem; color: var(--bs-secondary-color); }

    .cal-legend { display: flex; flex-wrap: wrap; gap: .75rem; font-size: .75rem; }
    .cal-legend span.cal-swatch { display: inline-block; width: 1.1rem; height: .7rem; border-radius: .35rem; vertical-align: middle; }

    /* Na mobilu se do sloupce nevejde jméno hosta — zůstane barva a datum. */
    @media (max-width: 575.98px) {
        .cal { --cal-col: 1.6rem; --cal-label: 5.5rem; }
        .cal-marker__label { display: none; }
    }
</style>
