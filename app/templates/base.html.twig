<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ brand_name }} — automatizace{% endblock %}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%22112%22>🏡</text></svg>">
    <link href="{{ asset('assets/bootstrap.min.css') }}" rel="stylesheet">
    <style>
        /* Badge drží čitelnou velikost i v hustých tabulkách se zmenšeným písmem. */
        .small .badge, .table.small .badge { font-size: .75rem; }

        /* Prázdná tabulka ukazuje jen hlášku, ne hlavičku sloupců bez dat. */
        .table:has(tr.table-empty) thead { display: none; }

        /* Široká tabulka: na mobilu je z každého řádku karta, popisek sloupce nese data-label. */
        @media (max-width: 767.98px) {
            .table-stack thead { display: none; }
            .table-stack, .table-stack tbody, .table-stack tr, .table-stack td { display: block; width: 100%; }
            .table-stack tr {
                background: #fff;
                border: 1px solid var(--bs-border-color);
                border-radius: .5rem;
                padding: .5rem .75rem;
                margin-bottom: .5rem;
            }
            .table-stack td {
                position: relative;
                padding: .2rem 0 .2rem 7rem;
                border: 0;
                text-align: left !important;
            }
            .table-stack td[data-label]::before {
                content: attr(data-label);
                position: absolute;
                left: 0;
                top: .2rem;
                width: 6.5rem;
                color: var(--bs-secondary-color);
            }
            .table-stack td:not([data-label]) { padding-left: 0; }
            .table-stack td:last-child { padding-left: 0; text-align: right !important; }
            .table-stack td[colspan] { padding-left: 0; }
            /* Řádek, který jen odděluje sekce (colspan), zůstává mimo karty. */
            .table-stack tr:has(> td[colspan]) {
                background: transparent;
                border: 0;
                padding: 0;
                margin-bottom: .25rem;
            }
        }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body class="bg-light">
<nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
    <div class="container">
        <a class="navbar-brand" href="{{ path('dashboard') }}">🏡 {{ brand_name }}</a>
        {% if app.user %}
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Menu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    {% if is_granted('ROLE_USER') %}
                        <li class="nav-item"><a class="nav-link" href="{{ path('dashboard') }}">Přehled</a></li>
                        <li class="nav-item"><a class="nav-link" href="{{ path('reservation_list') }}">Rezervace</a></li>
                        <li class="nav-item"><a class="nav-link" href="{{ path('economics_overview') }}">Ekonomika</a></li>
                        <li class="nav-item"><a class="nav-link" href="{{ path('account_index') }}">Účty</a></li>
                        {% if tax_profile.current.value != 'non_payer' %}
                            <li class="nav-item"><a class="nav-link" href="{{ path('vat_list') }}">DPH</a></li>
                        {% endif %}
                        <li class="nav-item"><a class="nav-link" href="{{ path('electricity_index') }}">Elektřina</a></li>
                    {% endif %}
                    <li class="nav-item"><a class="nav-link" href="{{ path('cleaning_index') }}">Úklid</a></li>
                    {% if is_granted('ROLE_USER') %}
                        <li class="nav-item"><a class="nav-link" href="{{ path('task_index') }}">Termíny</a></li>
                    {% endif %}
                    {% if is_granted('ROLE_USER') %}
                        <li class="nav-item"><a class="nav-link" href="{{ path('ubyport_index') }}">Ubyport</a></li>
                    {% endif %}
                    {% if is_granted('ROLE_ADMIN') %}
                        <li class="nav-item"><a class="nav-link" href="{{ path('general_settings_edit') }}">Nastavení</a></li>
                    {% endif %}
                </ul>
                <div class="d-flex align-items-center text-light small">
                    <a class="me-3 text-light text-decoration-none" href="{{ path('profile_index') }}">{{ app.user.userIdentifier }}</a>
                    <a class="btn btn-sm btn-outline-light" href="{{ path('app_logout') }}">Odhlásit</a>
                </div>
            </div>
        {% endif %}
    </div>
</nav>
<main class="container pb-5">
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endfor %}
    {% block body %}{% endblock %}
</main>
<footer class="container text-center text-muted small pb-4 pt-2 border-top">
    Běží na <a href="{{ product_url }}" target="_blank" rel="noopener" class="text-decoration-none fw-semibold">{{ product_name }}</a>
    — open-source automatizace rezervací pro malá ubytování.
    © {{ "now"|date("Y") }} ·
    <a href="{{ product_repo_url }}" target="_blank" rel="noopener" class="text-decoration-none">zdrojový kód</a>
</footer>
<script src="{{ asset('assets/bootstrap.bundle.min.js') }}"></script>
{% block javascripts %}{% endblock %}
</body>
</html>
