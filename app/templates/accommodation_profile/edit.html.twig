{% extends 'settings/base.html.twig' %}

{% block title %}Nastavení — ubytování{% endblock %}

{% block settings_active %}accommodation{% endblock %}

{% block settings_content %}
    <h2 class="h5 mb-2">Ubytování</h2>

    <p class="text-muted small">
        Objekt, který pronajímáte. Název a adresu odtud vidí host ve zprávách
        (pokyny k příjezdu) a jdou i do hlášení ubytovaných cizinců na
        <a href="{{ path('ubyport_settings_edit') }}">Ubyport</a>. Adresa dodavatele,
        která se tiskne na faktury, je jiná věc a nastavuje se ve
        <a href="{{ path('issuer_settings_edit') }}">Fakturaci</a>.
    </p>

    {% if isNew %}
        <div class="alert alert-warning">Údaje ještě nejsou vyplněné — bez nich zůstane adresa ve zprávách hostům prázdná.</div>
    {% endif %}

    {{ form_start(form) }}
        <div class="card mb-3">
            <div class="card-header py-2 fw-semibold">Objekt</div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-12">{{ form_row(form.nazev) }}</div>
                    <div class="col-12">{{ form_row(form.spojeni) }}</div>
                </div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header py-2 fw-semibold">Adresa</div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">{{ form_row(form.obec) }}</div>
                    <div class="col-md-6">{{ form_row(form.castObce) }}</div>
                    <div class="col-md-6">{{ form_row(form.ulice) }}</div>
                    <div class="col-md-3">{{ form_row(form.cp) }}</div>
                    <div class="col-md-3">{{ form_row(form.co) }}</div>
                    <div class="col-md-6">{{ form_row(form.psc) }}</div>
                    <div class="col-md-6">{{ form_row(form.okres) }}</div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end">
            <button type="submit" class="btn btn-primary">Uložit</button>
        </div>
    {{ form_end(form) }}
{% endblock %}
