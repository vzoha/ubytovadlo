{% extends 'settings/base.html.twig' %}

{% block title %}Nastavení — Ubyport{% endblock %}

{% block settings_active %}ubyport{% endblock %}

{% block settings_content %}
    <h2 class="h5 mb-2">Ubyport</h2>

    <p class="text-muted small">
        Hlášení ubytovaných cizinců cizinecké policii. IDUB a kód zařízení přidělila
        <a href="https://ubyport.policie.cz" target="_blank" rel="noopener">cizinecká policie</a>
        při registraci a používají se jen tady — zbytek hlavičky hlášení se bere
        z údajů o ubytování.
    </p>

    {{ form_start(form) }}
        <div class="card mb-3">
            <div class="card-header py-2 fw-semibold">Identifikátory od cizinecké policie</div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">{{ form_row(form.idub) }}</div>
                    <div class="col-md-6">{{ form_row(form.kod) }}</div>
                    <div class="col-12">{{ form_row(form.spojeni) }}</div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end mb-3">
            <button type="submit" class="btn btn-primary">Uložit</button>
        </div>
    {{ form_end(form) }}

    <div class="card">
        <div class="card-header py-2 fw-semibold">Údaje objektu v hlášení</div>
        <div class="card-body">
            <dl class="row mb-2 small">
                <dt class="col-sm-4">Název zařízení</dt>
                <dd class="col-sm-8">{{ profile.id ? profile.nazev : '—' }}</dd>
                <dt class="col-sm-4">Adresa</dt>
                <dd class="col-sm-8">{{ profile.id ? property_address : '—' }}</dd>
            </dl>
            <a href="{{ path('accommodation_profile_edit') }}" class="text-decoration-none small">Upravit v Ubytování →</a>
        </div>
    </div>
{% endblock %}
