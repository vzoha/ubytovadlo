# Repo je veřejné OSS — tady je hranice public/private. Pravidlo „kam co" viz
# CLAUDE.md → „Proces vývoje nových funkcí", krok 2. Tajemství (hesla, klíče)
# NEpatří ani sem — ta žijí jen v app/.env.local (viz app/.gitignore).

# WordPress instalace — udržovaná zvlášť, není součástí tohoto repa
/www/

# Vzorky dat a backfilly (e-maily, CSV evidence, jednorázové SQL) — mohou
# obsahovat reálná PII, do veřejného repa nepatří
/sources/

# Privátní overlay a interní dokumentace — identita instance, runbooky, plány
# (.gitignore nezná inline komentáře — vzor musí být sám na řádku, jinak se neaplikuje)
# kdo/co je tahle instance (doména, schránka, účty):
/CLAUDE.local.md
# interní runbooky a plány funkcí:
/docs/private/

# Editor / OS junk
.idea/
.vscode/
.DS_Store
*.swp

# Stažený obsah skillů (jako vendor/) — verze drží skills-lock.json
/.agents/

# Nastavení agenta: vlastní skilly a hooky projektu do repa patří (znalost o
# tomhle projektu, ne o stroji). Stažené skilly v .claude/skills jsou jen
# symlinky do .agents/ — ty ne, stejně jako lokální override a runtime soubory.
/.claude/*
!/.claude/settings.json
!/.claude/hooks/
!/.claude/skills/
/.claude/skills/*
!/.claude/skills/ubytovadlo-*
/.claude/settings.local.json
